<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>Ultimate File Explorer</Company>
    <Product>Ultimate File Explorer</Product>
    <Authors>Rocky Sharaf</Authors>
    <Copyright>Copyright © 2026 Rocky Sharaf. Licensed under the GNU GPL v3.</Copyright>
    <RepositoryUrl>https://github.com/RockySharaf/rock-preview</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>1.7.2</Version>
  </PropertyGroup>
</Project>
