<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manual measuring tool for search inside files (not part of Anything.sln). It compiles Core's sources into itself so
    it can call the internal readers directly, and compares the PDF reader with PyMuPDF. It only ever reads the files it
    measures; encrypted test copies are written to a temporary folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ContentProbe</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Anything.Core\**\*.cs" Exclude="..\..\src\Anything.Core\obj\**;..\..\src\Anything.Core\bin\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="pymupdf_probe.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
