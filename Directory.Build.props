<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>Rock Preview</Company>
    <Product>Rock Preview</Product>
    <Authors>Rocky Sharaf</Authors>
    <Copyright>Copyright © 2026 Rocky Sharaf. Licensed under the GNU GPL v3.</Copyright>
    <RepositoryUrl>https://github.com/RockySharaf/rock-preview</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>1.7.25</Version>
    <!-- The program's product version is the release's own ("1.7.25", not "1.7.25+<commit>"): code signing checks it
         against the release being signed (README › Code signing policy). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
